<?xml version="1.0"?>
<PropertyList>
  <generic>
    <output>
      <line_separator>newline</line_separator>
      <var_separator>,</var_separator>

      <chunk>
        <name>latitude</name>
        <node>/position/latitude-deg</node>
        <type>float</type>
        <format>%0.8f</format>
      </chunk>

      <chunk>
        <name>longitude</name>
        <node>/position/longitude-deg</node>
        <type>float</type>
        <format>%0.8f</format>
      </chunk>
    </output>
  </generic>
</PropertyList>
