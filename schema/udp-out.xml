<?xml version="1.0"?>
<PropertyList>
    <generic>
		<output>
			<!-- <binary_mode>true</binary_mode>
            <byte_order>host</byte_order> -->
            <line_separator>newline</line_separator>
            <var_separator>,</var_separator>
            <chunk>
               <name>/environment/wind-from-heading-deg</name>
               <type>float</type>
               <format>%.6f</format>
               <node>/environment/wind-from-heading-deg</node>
            </chunk>
			<chunk>
               <name>/environment/wind-speed-kt</name>
               <type>float</type>
               <format>%.6f</format>
               <node>/environment/wind-speed-kt</node>
            </chunk>
            <chunk>
                <name>/position/ground-elev-ft</name>
                <type>float</type>
                <format>%.6f</format>
                <node>/position/ground-elev-ft</node>
            </chunk>
        </output>
    </generic>
</PropertyList>
